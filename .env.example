# ============================================
# SecOps AI Assistant — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider Configuration ---
# At least one provider is required for AI analysis.
# If no keys are set, the system runs in "demo mode" with pre-computed results.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash

# Primary LLM provider: "openai" or "gemini"
LLM_PRIMARY_PROVIDER=openai

# --- Enrichment Configuration ---
# Mock enrichment is used by default (no keys needed).
# Set these to enable real threat intelligence lookups:
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Enrichment behavior
ENRICHMENT_TIMEOUT_SECONDS=5
ENRICHMENT_CACHE_TTL_SECONDS=3600

# --- Application Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Database (SQLite path, relative to project root)
DATABASE_PATH=data/secops.db

# --- Rate Limiting ---
LLM_MAX_CONCURRENT=3
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=2

# --- Security ---
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
